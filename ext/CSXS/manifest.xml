<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.ourtools.autosortbins" ExtensionBundleVersion="1.1.0" ExtensionBundleName="BinSorter Pro"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
