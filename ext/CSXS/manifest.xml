            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>BinSorter Pro</Menu>
          <Geometry>
            <Size><Height>560</Height><Width>300</Width></Size>
            <MinSize><Height>220</Height><Width>240</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.ourtools.autosortbins.aepanel">
      <HostList>
        <Host Name="AEFT" Version="[17.0,99.9]" />
      </HostList>
      <DispatchInfo>
